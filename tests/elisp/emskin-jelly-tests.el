;;; emskin-jelly-tests.el -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'emskin)
(defvar evil-local-mode nil)
(defvar evil-state nil)

(ert-deftest jelly-sends-insert-mode-and-cell-metrics ()
  (let ((evil-local-mode t) (evil-state 'insert) sent)
    (cl-letf (((symbol-function 'emskin--send) (lambda (msg) (setq sent msg)))
              ((symbol-function 'frame-char-width) (lambda (&rest _) 12))
              ((symbol-function 'frame-char-height) (lambda (&rest _) 24)))
      (emskin--jelly-send '(10 20 2 24 "#009688"))
      (should (eq (alist-get 'insert_mode sent) t))
      (should (= (alist-get 'cell_width sent) 12))
      (should (= (alist-get 'cell_height sent) 24))
      (setq evil-state 'normal)
      (emskin--jelly-send '(10 20 12 24 "#009688"))
      (should (eq (alist-get 'insert_mode sent) :json-false)))))

(ert-deftest jelly-deduplication-includes-mode ()
  (let ((evil-local-mode t) (evil-state 'normal)
        (emskin--jelly-last-info nil) (sent 0))
    (cl-letf (((symbol-function 'emskin--jelly-hide-buffer-cursor) (lambda (&rest _) 'box))
              ((symbol-function 'emskin--jelly-cursor-rect) (lambda (&rest _) '(10 20 12 24 "#009688")))
              ((symbol-function 'emskin--jelly-hide-visible-native-cursors) #'ignore)
              ((symbol-function 'emskin--jelly-send) (lambda (&rest _) (cl-incf sent))))
      (emskin--jelly-push-current)
      (emskin--jelly-push-current)
      (should (= sent 1))
      (setq evil-state 'insert)
      (emskin--jelly-push-current)
      (should (= sent 2)))))
